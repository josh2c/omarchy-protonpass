#!/usr/bin/env bash
set -euo pipefail

readonly DOCTOR_TIMEOUT_SECONDS=5
readonly INDEX_TIMEOUT_SECONDS=20
readonly COPY_TIMEOUT_SECONDS=15
readonly LOCK_TIMEOUT_SECONDS=15

emit_dispatch_error() {
  jq -cn '{
    schemaVersion: 1,
    command: "unknown",
    state: "error",
    message: "Invalid helper arguments"
  }'
}

emit_command_error() {
  local command_name=$1
  jq -cn --arg command "$command_name" '{
    schemaVersion: 1,
    command: $command,
    state: "error",
    message: "Invalid helper arguments"
  }'
}

emit_doctor() {
  local state=$1 message=$2 pass_present=$3 version=$4 clipboard_present=$5
  jq -cn \
    --arg state "$state" \
    --arg message "$message" \
    --argjson passPresent "$pass_present" \
    --arg version "$version" \
    --argjson clipboardPresent "$clipboard_present" \
    '{
      schemaVersion: 1,
      command: "doctor",
      state: $state,
      message: $message,
      passCli: {present: $passPresent, version: $version},
      wlClipboard: {present: $clipboardPresent}
    }'
}

emit_index() {
  local state=$1 message=$2 items=$3 warnings=$4
  jq -cn \
    --arg state "$state" \
    --arg message "$message" \
    --argjson items "$items" \
    --argjson warnings "$warnings" \
    '{
      schemaVersion: 1,
      command: "index",
      state: $state,
      message: $message,
      items: $items,
      warnings: $warnings
    }'
}

emit_copy() {
  local state=$1 message=$2 field=$3 fallback_used=$4 clear_seconds=$5
  jq -cn \
    --arg state "$state" \
    --arg message "$message" \
    --arg field "$field" \
    --argjson fallbackUsed "$fallback_used" \
    --argjson clearSeconds "$clear_seconds" \
    '{
      schemaVersion: 1,
      command: "copy",
      state: $state,
      message: $message,
      field: $field,
      fallbackUsed: $fallbackUsed,
      clearSeconds: $clearSeconds
    }'
}

emit_copy_classified_failure() {
  local no_field_message=$1 message=$CLASSIFIED_MESSAGE
  if [[ $CLASSIFIED_STATE == no-field ]]; then
    message=$no_field_message
  elif [[ $CLASSIFIED_STATE == error ]]; then
    message="Copy failed — check connection and try again"
  fi
  emit_copy "$CLASSIFIED_STATE" "$message" \
    "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
}

emit_lock() {
  local state=$1 message=$2
  jq -cn --arg state "$state" --arg message "$message" '{
    schemaVersion: 1,
    command: "lock",
    state: $state,
    message: $message
  }'
}

run_pass_cli() {
  local timeout_seconds=$1
  shift
  PASS_LOG_LEVEL=off MUON_LOG_LEVEL=off \
    timeout --foreground "${timeout_seconds}s" pass-cli "$@"
}

# The three namerefs are output parameters consumed by callers.
# shellcheck disable=SC2034
run_pass_cli_captured() {
  local stdout_name=$1 stderr_name=$2 status_name=$3 timeout_seconds=$4
  shift 4
  local stderr_read stderr_write stderr_pid capture_write
  local -n captured_stdout=$stdout_name captured_stderr=$stderr_name captured_status=$status_name

  coproc STDERR_PIPE { cat; }
  stderr_read=${STDERR_PIPE[0]}
  stderr_write=${STDERR_PIPE[1]}
  stderr_pid=$STDERR_PIPE_PID
  exec {capture_write}>&"$stderr_write"
  exec {stderr_write}>&-

  if captured_stdout=$(run_pass_cli "$timeout_seconds" "$@" 2>&"$capture_write"); then
    captured_status=0
  else
    captured_status=$?
  fi

  exec {capture_write}>&-
  captured_stderr=$(cat <&"$stderr_read")
  exec {stderr_read}>&-
  wait "$stderr_pid"
}

# The value nameref is the caller's single unexported secret variable.
# shellcheck disable=SC2034
run_pass_cli_secret_captured() {
  local value_name=$1 stderr_name=$2 status_name=$3 timeout_seconds=$4
  shift 4
  local stderr_read stderr_write stderr_pid capture_write
  local -n captured_value=$value_name captured_stderr=$stderr_name captured_status=$status_name

  coproc SECRET_STDERR_PIPE { cat; }
  stderr_read=${SECRET_STDERR_PIPE[0]}
  stderr_write=${SECRET_STDERR_PIPE[1]}
  stderr_pid=$SECRET_STDERR_PIPE_PID
  exec {capture_write}>&"$stderr_write"
  exec {stderr_write}>&-

  if captured_value=$(
    run_pass_cli "$timeout_seconds" "$@" 2>&"$capture_write"
    command_status=$?
    printf x
    exit "$command_status"
  ); then
    captured_status=0
  else
    captured_status=$?
  fi

  exec {capture_write}>&-
  captured_stderr=$(cat <&"$stderr_read")
  exec {stderr_read}>&-
  wait "$stderr_pid"

  captured_value=${captured_value%x}
  captured_value=${captured_value%$'\n'}
}

# Outputs are globals so callers can classify without reparsing or serializing stderr.
# shellcheck disable=SC2034
classify_failure() {
  local command_name=$1 status=$2 stderr_blob=$3
  local folded=${stderr_blob,,}

  CLASSIFIED_STATE=error
  CLASSIFIED_KIND=unknown
  CLASSIFIED_MESSAGE="Something went wrong talking to pass-cli"

  if ! command -v pass-cli >/dev/null 2>&1; then
    CLASSIFIED_STATE=cli-missing
    CLASSIFIED_KIND=cli-missing
    CLASSIFIED_MESSAGE="Proton Pass CLI not found"
  elif [[ $folded == *"session has been invalidated"* ||
          $folded == *"log in again"* ||
          $folded == *"non-existent session"* ]]; then
    CLASSIFIED_STATE=logged-out
    CLASSIFIED_KIND=session-expired
    CLASSIFIED_MESSAGE="Session expired — sign in again"
  elif [[ $folded == *"requires an authenticated client"* ||
          $folded == *"no active session"* ]]; then
    CLASSIFIED_STATE=logged-out
    CLASSIFIED_KIND=logged-out
    CLASSIFIED_MESSAGE="Not signed in to Proton Pass"
  elif [[ $folded == *"session is locked"* ]]; then
    CLASSIFIED_STATE=locked
    CLASSIFIED_KIND=locked
    CLASSIFIED_MESSAGE="Session locked"
  elif [[ $command_name == lock &&
          ( $folded == *"session is not locked"* ||
            $folded == *"session has no lock"* ||
            $folded == *"create one first with"* ) ]]; then
    CLASSIFIED_STATE=no-lock
    CLASSIFIED_KIND=no-lock
    CLASSIFIED_MESSAGE="No session lock configured — run pass-cli session create-lock"
  elif [[ $command_name == copy &&
          ( $folded == *"field does not exist"* ||
            $folded == *"no totp fields found in this item"* ) ]]; then
    CLASSIFIED_STATE=no-field
    CLASSIFIED_KIND=no-field
    CLASSIFIED_MESSAGE="Requested field is not available"
  elif [[ ( $status -eq 124 && -z $stderr_blob ) ||
          $folded == *"network is unreachable"* ||
          $folded == *"failed to connect"* ||
          $folded == *"error while connecting"* ||
          $folded == *"name or service not known"* ||
          $folded == *"temporary failure in name resolution"* ||
          $folded == *"dns error"* ||
          $folded == *"connection refused"* ||
          $folded == *"connection reset"* ||
          $folded == *"connection timed out"* ]]; then
    CLASSIFIED_STATE=unreachable
    if [[ $status -eq 124 && -z $stderr_blob ]]; then
      CLASSIFIED_KIND=timeout
      CLASSIFIED_MESSAGE="Proton Pass CLI timed out"
    else
      CLASSIFIED_KIND=network
      CLASSIFIED_MESSAGE="Can't reach Proton"
    fi
  fi
}

valid_id() {
  [[ $1 =~ ^[A-Za-z0-9+/=_-]{1,256}$ ]]
}

normalize_clear_seconds() {
  local raw=$1 normalized
  [[ $raw =~ ^[0-9]+$ ]] || return 1
  normalized=${raw#"${raw%%[!0]*}"}
  [[ -n $normalized ]] || normalized=0
  (( ${#normalized} <= 3 )) || return 1
  (( 10#$normalized <= 300 )) || return 1
  NORMALIZED_CLEAR_SECONDS=$((10#$normalized))
}

doctor_command() {
  local pass_present=false clipboard_present=false
  local version="" version_output="" message="Dependencies are available"

  if command -v pass-cli >/dev/null 2>&1; then
    pass_present=true
    if version_output=$(run_pass_cli "$DOCTOR_TIMEOUT_SECONDS" --version 2>/dev/null) &&
       [[ $version_output =~ ([0-9]+\.[0-9]+\.[0-9]+) ]]; then
      version=${BASH_REMATCH[1]}
    fi
  fi

  if command -v wl-copy >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
    clipboard_present=true
  fi

  if [[ $pass_present == false || $clipboard_present == false ]]; then
    emit_doctor missing-deps "Required dependencies are missing" \
      "$pass_present" "$version" "$clipboard_present"
  elif [[ -z $version ]]; then
    emit_doctor ok "Could not determine pass-cli version" \
      "$pass_present" "$version" "$clipboard_present"
  elif [[ ${version%%.*} != 2 ]]; then
    emit_doctor ok "Unexpected pass-cli major version; expected 2.x" \
      "$pass_present" "$version" "$clipboard_present"
  else
    emit_doctor ok "$message" "$pass_present" "$version" "$clipboard_present"
  fi
}

parse_index_args() {
  local exclude_vaults="" seen_exclude=false

  while (( $# > 0 )); do
    case $1 in
      --exclude-vaults)
        if [[ $seen_exclude == true || $# -lt 2 ]]; then return 2; fi
        exclude_vaults=$2
        seen_exclude=true
        shift 2
        ;;
      *) return 2 ;;
    esac
  done

  [[ $seen_exclude == true ]] || return 2
  INDEX_EXCLUDE_VAULTS=$exclude_vaults
}

parse_copy_args() {
  local share_id="" item_id="" field="" clear_seconds=""
  local seen_share=false seen_item=false seen_field=false seen_clear=false paste_once=false

  while (( $# > 0 )); do
    case $1 in
      --share-id)
        if [[ $seen_share == true || $# -lt 2 ]]; then return 2; fi
        share_id=$2
        seen_share=true
        shift 2
        ;;
      --item-id)
        if [[ $seen_item == true || $# -lt 2 ]]; then return 2; fi
        item_id=$2
        seen_item=true
        shift 2
        ;;
      --field)
        if [[ $seen_field == true || $# -lt 2 ]]; then return 2; fi
        field=$2
        seen_field=true
        shift 2
        ;;
      --clear-seconds)
        if [[ $seen_clear == true || $# -lt 2 ]]; then return 2; fi
        clear_seconds=$2
        seen_clear=true
        shift 2
        ;;
      --paste-once)
        if [[ $paste_once == true ]]; then return 2; fi
        paste_once=true
        shift
        ;;
      *) return 2 ;;
    esac
  done

  [[ $seen_share == true && $seen_item == true && $seen_field == true && $seen_clear == true ]] || return 2
  valid_id "$share_id" || return 2
  valid_id "$item_id" || return 2
  [[ $field == username || $field == password || $field == totp ]] || return 2
  normalize_clear_seconds "$clear_seconds" || return 2
  COPY_SHARE_ID=$share_id
  COPY_ITEM_ID=$item_id
  COPY_FIELD=$field
  COPY_CLEAR_SECONDS=$NORMALIZED_CLEAR_SECONDS
  COPY_PASTE_ONCE=$paste_once
}

index_command() {
  local vault_stdout="" vault_stderr="" vaults="[]" items="[]" warnings="[]"
  local vault_status=0 vault_json share_id item_stdout item_stderr item_status mapped

  if ! command -v pass-cli >/dev/null 2>&1; then
    classify_failure index 127 ""
    emit_index "$CLASSIFIED_STATE" "$CLASSIFIED_MESSAGE" '[]' '[]'
    return 0
  fi

  run_pass_cli_captured vault_stdout vault_stderr vault_status \
    "$INDEX_TIMEOUT_SECONDS" vault list --output json
  if (( vault_status != 0 )); then
    classify_failure index "$vault_status" "$vault_stderr"
    emit_index "$CLASSIFIED_STATE" "$CLASSIFIED_MESSAGE" '[]' '[]'
    return 0
  fi

  if ! jq -e '
      type == "object" and
      (.vaults | type) == "array" and
      all(.vaults[];
        (.name | type) == "string" and
        (.share_id | type) == "string" and
        (.share_id | test("^[A-Za-z0-9+/=_-]{1,256}$"))
      )
    ' <<<"$vault_stdout" >/dev/null 2>&1; then
    emit_index error "Something went wrong talking to pass-cli" '[]' '[]'
    return 0
  fi

  vaults=$(jq -c --arg excluded "$INDEX_EXCLUDE_VAULTS" '
    def trim: sub("^[[:space:]]+"; "") | sub("[[:space:]]+$"; "");
    ($excluded | split(",") | map(trim) | map(select(length > 0))) as $excludedNames
    | [.vaults[] | select(.name as $name | ($excludedNames | index($name) | not))]
  ' <<<"$vault_stdout")

  while IFS= read -r vault_json; do
    share_id=$(jq -r '.share_id' <<<"$vault_json")
    run_pass_cli_captured item_stdout item_stderr item_status \
      "$INDEX_TIMEOUT_SECONDS" item list \
      --share-id "$share_id" \
      --filter-type login \
      --filter-state active \
      --output json
    : "$item_stderr"

    if (( item_status != 0 )) || ! jq -e --arg shareId "$share_id" '
        type == "object" and
        (.items | type) == "array" and
        all(.items[];
          (.id | type) == "string" and
          (.id | test("^[A-Za-z0-9+/=_-]{1,256}$")) and
          (.share_id | type) == "string" and
          .share_id == $shareId and
          (.title | type) == "string"
        )
      ' <<<"$item_stdout" >/dev/null 2>&1; then
      warnings=$(jq -cn --argjson warnings "$warnings" \
        '$warnings + ["A vault could not be loaded"]')
      continue
    fi

    mapped=$(jq -c --argjson vault "$vault_json" '[
      .items[] | {
        itemId: .id,
        shareId: .share_id,
        vaultName: $vault.name,
        title: .title
      }
    ]' <<<"$item_stdout")
    items=$(jq -cn --argjson items "$items" --argjson mapped "$mapped" '$items + $mapped')
  done < <(jq -c '.[]' <<<"$vaults")

  if [[ $warnings == '[]' ]]; then
    emit_index ready "Login items ready" "$items" "$warnings"
  else
    emit_index ready "Some vaults could not be loaded" "$items" "$warnings"
  fi
}

copy_command() {
  local +x val="" stderr_blob="" status=0 fallback_used=false hash secs cur
  local -a copy_args=(--sensitive)

  if ! command -v pass-cli >/dev/null 2>&1; then
    classify_failure copy 127 ""
    emit_copy "$CLASSIFIED_STATE" "$CLASSIFIED_MESSAGE" \
      "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
    return 0
  fi
  if ! command -v wl-copy >/dev/null 2>&1 ||
     { (( COPY_CLEAR_SECONDS > 0 )) && ! command -v wl-paste >/dev/null 2>&1; }; then
    emit_copy error "Copy failed — check connection and try again" \
      "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
    return 0
  fi

  case $COPY_FIELD in
    username)
      run_pass_cli_secret_captured val stderr_blob status \
        "$COPY_TIMEOUT_SECONDS" item view \
        --share-id "$COPY_SHARE_ID" --item-id "$COPY_ITEM_ID" --field username
      if (( status != 0 )); then
        classify_failure copy "$status" "$stderr_blob"
        if [[ $CLASSIFIED_STATE != no-field ]]; then
          emit_copy_classified_failure "No username or email on this item"
          unset val
          return 0
        fi
      fi
      if (( status != 0 )) || [[ -z $val ]]; then
        run_pass_cli_secret_captured val stderr_blob status \
          "$COPY_TIMEOUT_SECONDS" item view \
          --share-id "$COPY_SHARE_ID" --item-id "$COPY_ITEM_ID" --field email
        if (( status != 0 )); then
          classify_failure copy "$status" "$stderr_blob"
          emit_copy_classified_failure "No username or email on this item"
          unset val
          return 0
        fi
        if [[ -z $val ]]; then
          emit_copy no-field "No username or email on this item" \
            "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
          unset val
          return 0
        fi
        fallback_used=true
      fi
      ;;
    password)
      run_pass_cli_secret_captured val stderr_blob status \
        "$COPY_TIMEOUT_SECONDS" item view \
        --share-id "$COPY_SHARE_ID" --item-id "$COPY_ITEM_ID" --field password
      if (( status != 0 )); then
        classify_failure copy "$status" "$stderr_blob"
        emit_copy_classified_failure "No password on this item"
        unset val
        return 0
      fi
      if [[ -z $val ]]; then
        emit_copy no-field "No password on this item" \
          "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
        unset val
        return 0
      fi
      ;;
    totp)
      run_pass_cli_secret_captured val stderr_blob status \
        "$COPY_TIMEOUT_SECONDS" item totp \
        --share-id "$COPY_SHARE_ID" --item-id "$COPY_ITEM_ID" --output json
      if (( status != 0 )); then
        classify_failure copy "$status" "$stderr_blob"
        emit_copy_classified_failure "No TOTP on this item"
        unset val
        return 0
      fi
      if ! printf '%s' "$val" | jq -e '
          type == "object" and length > 0 and
          all(.[]; type == "string" and length > 0)
        ' >/dev/null 2>&1; then
        emit_copy error "Copy failed — check connection and try again" \
          "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
        unset val
        return 0
      fi
      val=$(printf '%s' "$val" | jq -r '
        if has("totp") then .totp
        else
          (to_entries | map(select(.key | endswith("_uri") | not))) as $codes
          | if ($codes | length) > 0 then $codes[0].value
            else (to_entries[0].value)
            end
        end
      '; printf x)
      val=${val%x}
      val=${val%$'\n'}
      ;;
  esac

  if [[ $COPY_PASTE_ONCE == true ]]; then copy_args+=(-o); fi
  if ! printf '%s' "$val" | wl-copy "${copy_args[@]}" >/dev/null 2>&1; then
    unset val
    emit_copy error "Copy failed — check connection and try again" \
      "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
    return 0
  fi
  hash=$(printf '%s' "$val" | sha256sum | cut -d' ' -f1)
  unset val

  if (( COPY_CLEAR_SECONDS > 0 )); then
    secs=$COPY_CLEAR_SECONDS
    ( exec >/dev/null 2>&1 </dev/null
      sleep "$secs"
      cur=$(wl-paste --no-newline 2>/dev/null | sha256sum | cut -d' ' -f1)
      [ "$cur" = "$hash" ] && wl-copy --clear ) &
    disown
  fi

  emit_copy copied "Copied to clipboard" \
    "$COPY_FIELD" "$fallback_used" "$COPY_CLEAR_SECONDS"
}

lock_command() {
  local stdout="" stderr_blob="" status=0

  if ! command -v pass-cli >/dev/null 2>&1; then
    classify_failure lock 127 ""
    emit_lock "$CLASSIFIED_STATE" "$CLASSIFIED_MESSAGE"
    return 0
  fi

  run_pass_cli_captured stdout stderr_blob status \
    "$LOCK_TIMEOUT_SECONDS" session lock
  : "$stdout"
  if (( status == 0 )); then
    emit_lock locked "Session locked"
  else
    classify_failure lock "$status" "$stderr_blob"
    emit_lock "$CLASSIFIED_STATE" "$CLASSIFIED_MESSAGE"
  fi
}

main() {
  local command_name
  if (( $# == 0 )); then
    emit_dispatch_error
    return 2
  fi

  command_name=$1
  shift
  case $command_name in
    doctor)
      if (( $# != 0 )); then emit_command_error doctor; return 2; fi
      doctor_command
      ;;
    index)
      if ! parse_index_args "$@"; then emit_command_error index; return 2; fi
      index_command
      ;;
    copy)
      if ! parse_copy_args "$@"; then emit_command_error copy; return 2; fi
      copy_command
      ;;
    lock)
      if (( $# != 0 )); then emit_command_error lock; return 2; fi
      lock_command
      ;;
    *)
      emit_dispatch_error
      return 2
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi

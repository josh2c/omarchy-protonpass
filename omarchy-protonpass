#!/usr/bin/env bash
set -euo pipefail

readonly DOCTOR_TIMEOUT_SECONDS=5
readonly INDEX_TIMEOUT_SECONDS=20
readonly COPY_TIMEOUT_SECONDS=15
readonly CREATE_TIMEOUT_SECONDS=20
readonly LOCK_TIMEOUT_SECONDS=15
readonly LOGOUT_TIMEOUT_SECONDS=15
readonly CLIP_HASH_BASENAME=omarchy-protonpass.clip
readonly RECENTS_DIRNAME=omarchy-protonpass
readonly RECENTS_BASENAME=recents.json
readonly RECENTS_LIMIT=8
# Titles and vault names come from whoever shared the vault and are otherwise
# unbounded, so the index truncates them for display rather than rejecting the
# item — one hostile entry must not hide the rest of a legitimate vault.
readonly INDEX_DISPLAY_TEXT_LIMIT=256
# Resource budget for the index path. Item metadata is authored by whoever can
# edit a vault, and an accepted shared vault means that is not always the user.
# pass-cli is a trusted channel; what arrives over it is not trusted data, so
# every dimension of it is bounded: how many vaults, how many items, how many
# bytes per response, and how long the whole walk may take. Titles and vault
# names are already capped above; these cap the counts and the aggregate work.
readonly INDEX_MAX_VAULTS=100
readonly INDEX_MAX_ITEMS_PER_VAULT=5000
readonly INDEX_MAX_ITEMS_TOTAL=10000
readonly INDEX_MAX_RESPONSE_BYTES=10485760
readonly INDEX_DEADLINE_SECONDS=60

emit_doctor() {
  local state=$1 message=$2 pass_present=$3 version=$4 clipboard_present=$5
  jq -cn \
    --arg state "$state" \
    --arg message "$message" \
    --argjson passPresent "$pass_present" \
    --arg version "$version" \
    --argjson clipboardPresent "$clipboard_present" \
    '{
      schemaVersion: 1,
      command: "doctor",
      state: $state,
      message: $message,
      passCli: {present: $passPresent, version: $version},
      wlClipboard: {present: $clipboardPresent}
    }'
}

emit_index() {
  local state=$1 message=$2 items=$3 warnings=$4 vaults=$5
  # The item array arrives on stdin, never as an argument. Linux caps a single
  # argument at MAX_ARG_STRLEN (32 pages, 128 KiB), which an index of a few
  # hundred logins exceeds on its own -- no hostile vault required. Warnings and
  # vaults stay on argv: both are bounded by INDEX_MAX_VAULTS and short strings.
  printf '%s' "$items" | jq -c \
    --arg state "$state" \
    --arg message "$message" \
    --argjson warnings "$warnings" \
    --argjson vaults "$vaults" \
    '{
      schemaVersion: 1,
      command: "index",
      state: $state,
      message: $message,
      items: .,
      warnings: $warnings,
      vaults: $vaults
    }'
}

emit_copy() {
  local state=$1 message=$2 field=$3 fallback_used=$4 clear_seconds=$5
  jq -cn \
    --arg state "$state" \
    --arg message "$message" \
    --arg field "$field" \
    --argjson fallbackUsed "$fallback_used" \
    --argjson clearSeconds "$clear_seconds" \
    '{
      schemaVersion: 1,
      command: "copy",
      state: $state,
      message: $message,
      field: $field,
      fallbackUsed: $fallbackUsed,
      clearSeconds: $clearSeconds
    }'
}

emit_create() {
  local state=$1 message=$2 item_id=${3:-} share_id=${4:-}
  if [[ $state == created && -n $item_id && -n $share_id ]]; then
    jq -cn \
      --arg state "$state" \
      --arg message "$message" \
      --arg itemId "$item_id" \
      --arg shareId "$share_id" '{
        schemaVersion: 1,
        command: "create",
        state: $state,
        message: $message,
        itemId: $itemId,
        shareId: $shareId
      }'
  else
    emit_simple create "$state" "$message"
  fi
}

emit_copy_classified_failure() {
  local no_field_message=$1 message=$CLASSIFIED_MESSAGE
  if [[ $CLASSIFIED_STATE == no-field ]]; then
    message=$no_field_message
  elif [[ $CLASSIFIED_STATE == error ]]; then
    message="Copy failed — check connection and try again"
  fi
  emit_copy "$CLASSIFIED_STATE" "$message" \
    "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
}

# An unrecognised command name reports as "unknown"; a recognised command with
# bad flags reports under its own name.
emit_argument_error() {
  emit_simple "${1:-unknown}" error "Invalid helper arguments"
}

emit_simple() {
  local command_name=$1 state=$2 message=$3
  jq -cn --arg command "$command_name" --arg state "$state" --arg message "$message" '{
    schemaVersion: 1,
    command: $command,
    state: $state,
    message: $message
  }'
}

emit_recents() {
  local state=$1 message=$2 recents=$3
  jq -cn \
    --arg state "$state" \
    --arg message "$message" \
    --argjson recents "$recents" '{
      schemaVersion: 1,
      command: "recents",
      state: $state,
      message: $message,
      recents: $recents
    }'
}

run_pass_cli() {
  local timeout_seconds=$1
  shift
  PASS_LOG_LEVEL=off MUON_LOG_LEVEL=off \
    timeout --foreground "${timeout_seconds}s" pass-cli "$@"
}

# pass-cli stderr lands in a private scratch file for the length of one call.
# A plain redirect cannot block; a pipe reader waiting for end-of-file can,
# because any descendant the CLI leaves behind keeps the write end open.
STDERR_CAPTURE_FILE=""
INDEX_SCRATCH_FILE=""
# Set by callers that read attacker-influenced list output; 0 means no cap.
CAPTURE_MAX_BYTES=0
CAPTURE_WAS_TRUNCATED=false
# The residue contract (tests/security-test.sh) allows exactly one file to
# outlive the helper in the runtime directory, the clipboard hash. Both scratch
# files are removed on every exit path by this single trap; a second trap would
# silently replace the first.
remove_scratch_files() {
  [[ -n $STDERR_CAPTURE_FILE ]] && rm -f -- "$STDERR_CAPTURE_FILE"
  [[ -n $INDEX_SCRATCH_FILE ]] && rm -f -- "$INDEX_SCRATCH_FILE"
  return 0
}

open_stderr_capture() {
  local directory=${XDG_RUNTIME_DIR:-} path created=false noclobber_was_set=false
  if [[ -n $STDERR_CAPTURE_FILE ]]; then
    return 0
  fi
  if [[ -z $directory || ! -d $directory || -L $directory ]]; then
    directory=${TMPDIR:-/tmp}
  fi
  [[ -d $directory && ! -L $directory ]] || return 1
  path=$directory/.omarchy-protonpass.stderr.$$
  umask 077
  # noclobber creates with O_EXCL, so an existing file or a planted symlink
  # fails the open instead of being written through; mktemp then picks a name
  # nobody can predict.
  if [[ -o noclobber ]]; then
    noclobber_was_set=true
  fi
  set -o noclobber
  if : >"$path" 2>/dev/null; then created=true; fi
  if [[ $noclobber_was_set == false ]]; then
    set +o noclobber
  fi
  if [[ $created == false ]]; then
    path=$(mktemp "$directory/.omarchy-protonpass.stderr.XXXXXX") || return 1
  fi
  STDERR_CAPTURE_FILE=$path
  trap remove_scratch_files EXIT
}

open_index_scratch() {
  local directory=${XDG_RUNTIME_DIR:-} path
  if [[ -n $INDEX_SCRATCH_FILE ]]; then
    : >"$INDEX_SCRATCH_FILE" || return 1
    return 0
  fi
  if [[ -z $directory || ! -d $directory || -L $directory ]]; then
    directory=${TMPDIR:-/tmp}
  fi
  [[ -d $directory && ! -L $directory ]] || return 1
  umask 077
  path=$(mktemp "$directory/.omarchy-protonpass.index.XXXXXX") || return 1
  INDEX_SCRATCH_FILE=$path
  trap remove_scratch_files EXIT
}

# The three namerefs are output parameters consumed by callers. With
# preserve_trailing the captured value keeps every byte pass-cli wrote, so the
# secret paths pass true; the metadata paths pass false and read like a plain
# command substitution.
# shellcheck disable=SC2034
run_pass_cli_captured() {
  local preserve_trailing=$1 stdout_name=$2 stderr_name=$3 status_name=$4 timeout_seconds=$5
  shift 5
  local stderr_target=/dev/null
  local -n captured_stdout=$stdout_name captured_stderr=$stderr_name captured_status=$status_name

  if open_stderr_capture; then
    stderr_target=$STDERR_CAPTURE_FILE
    : >"$stderr_target"
  fi

  if [[ $preserve_trailing == true ]]; then
    # The x sentinel fences the value so command substitution cannot eat a
    # trailing newline that belongs to the secret.
    if captured_stdout=$(
      run_pass_cli "$timeout_seconds" "$@" 2>"$stderr_target"
      command_status=$?
      printf x
      exit "$command_status"
    ); then
      captured_status=0
    else
      captured_status=$?
    fi
    captured_stdout=${captured_stdout%x}
    captured_stdout=${captured_stdout%$'\n'}
  else
    # A list response is attacker-influenced in size, so it is truncated at the
    # read rather than after it lands in a variable. Truncated JSON fails the
    # caller's contract check, which is the intended fail-closed path;
    # CAPTURE_WAS_TRUNCATED lets the caller say why.
    CAPTURE_WAS_TRUNCATED=false
    if (( CAPTURE_MAX_BYTES > 0 )); then
      if captured_stdout=$(
        run_pass_cli "$timeout_seconds" "$@" 2>"$stderr_target" \
          | head -c "$CAPTURE_MAX_BYTES"
        exit "${PIPESTATUS[0]}"
      ); then
        captured_status=0
      else
        captured_status=$?
      fi
      if (( ${#captured_stdout} >= CAPTURE_MAX_BYTES )); then
        CAPTURE_WAS_TRUNCATED=true
      fi
    elif captured_stdout=$(run_pass_cli "$timeout_seconds" "$@" 2>"$stderr_target"); then
      captured_status=0
    else
      captured_status=$?
    fi
  fi

  captured_stderr=""
  if [[ $stderr_target != /dev/null ]]; then
    captured_stderr=$(<"$stderr_target")
    : >"$stderr_target"
  fi
}

# Outputs are globals so callers can classify without reparsing or serializing stderr.
# shellcheck disable=SC2034
classify_failure() {
  local command_name=$1 status=$2 stderr_blob=$3
  local folded=${stderr_blob,,}

  CLASSIFIED_STATE=error
  CLASSIFIED_KIND=unknown
  CLASSIFIED_MESSAGE="Something went wrong talking to pass-cli"

  if ! command -v pass-cli >/dev/null 2>&1; then
    CLASSIFIED_STATE=cli-missing
    CLASSIFIED_KIND=cli-missing
    CLASSIFIED_MESSAGE="Proton Pass CLI not found"
  elif [[ $folded == *"session has been invalidated"* ||
          $folded == *"log in again"* ||
          $folded == *"non-existent session"* ]]; then
    CLASSIFIED_STATE=logged-out
    CLASSIFIED_KIND=session-expired
    CLASSIFIED_MESSAGE="Session expired — sign in again"
  elif [[ $folded == *"requires an authenticated client"* ||
          $folded == *"no active session"* ]]; then
    CLASSIFIED_STATE=logged-out
    CLASSIFIED_KIND=logged-out
    CLASSIFIED_MESSAGE="Not signed in to Proton Pass"
  elif [[ $folded == *"session is locked"* ]]; then
    CLASSIFIED_STATE=locked
    CLASSIFIED_KIND=locked
    CLASSIFIED_MESSAGE="Session locked"
  elif [[ $command_name == lock &&
          ( $folded == *"session is not locked"* ||
            $folded == *"session has no lock"* ||
            $folded == *"create one first with"* ) ]]; then
    CLASSIFIED_STATE=no-lock
    CLASSIFIED_KIND=no-lock
    CLASSIFIED_MESSAGE="No session lock configured — run pass-cli session create-lock"
  elif [[ $command_name == copy &&
          ( $folded == *"field does not exist"* ||
            $folded == *"no totp fields found in this item"* ) ]]; then
    CLASSIFIED_STATE=no-field
    CLASSIFIED_KIND=no-field
    CLASSIFIED_MESSAGE="Requested field is not available"
  elif [[ ( $status -eq 124 && -z $stderr_blob ) ||
          $folded == *"network is unreachable"* ||
          $folded == *"failed to connect"* ||
          $folded == *"error while connecting"* ||
          $folded == *"name or service not known"* ||
          $folded == *"temporary failure in name resolution"* ||
          $folded == *"dns error"* ||
          $folded == *"connection refused"* ||
          $folded == *"connection reset"* ||
          $folded == *"connection timed out"* ]]; then
    CLASSIFIED_STATE=unreachable
    if [[ $status -eq 124 && -z $stderr_blob ]]; then
      CLASSIFIED_KIND=timeout
      CLASSIFIED_MESSAGE="Proton Pass CLI timed out"
    else
      CLASSIFIED_KIND=network
      CLASSIFIED_MESSAGE="Can't reach Proton"
    fi
  fi
}

# Every failing command classifies and then emits in the same shape, so the
# twelve sites share one tail. no_field_message only applies to copy.
fail_classified() {
  local command_name=$1 status=$2 stderr_blob=$3 no_field_message=${4:-}
  classify_failure "$command_name" "$status" "$stderr_blob"
  case $command_name in
    index) emit_index "$CLASSIFIED_STATE" "$CLASSIFIED_MESSAGE" '[]' '[]' '[]' ;;
    copy) emit_copy_classified_failure "$no_field_message" ;;
    create) emit_create "$CLASSIFIED_STATE" "$CLASSIFIED_MESSAGE" ;;
    lock) emit_simple lock "$CLASSIFIED_STATE" "$CLASSIFIED_MESSAGE" ;;
    logout)
      case $CLASSIFIED_STATE in
        logged-out) emit_simple logout logged-out-ok "Already signed out of Proton Pass" ;;
        cli-missing) emit_simple logout cli-missing "$CLASSIFIED_MESSAGE" ;;
        unreachable) emit_simple logout unreachable "$CLASSIFIED_MESSAGE" ;;
        *) emit_simple logout error "Could not sign out of Proton Pass" ;;
      esac
      ;;
  esac
}

valid_id() {
  [[ $1 =~ ^[A-Za-z0-9+/=_-]{1,256}$ ]]
}

# One batched read of the kernel CSPRNG feeds every draw of a generation run;
# rejection sampling below still decides each value on its own cutoff.
RANDOM_POOL=()
RANDOM_POOL_INDEX=0

refill_random_pool() {
  local -a words=()
  read -r -a words -d '' < <(od -An -N256 -tu4 /dev/urandom) || true
  (( ${#words[@]} > 0 )) || return 1
  RANDOM_POOL=("${words[@]}")
  RANDOM_POOL_INDEX=0
}

next_random_word() {
  if (( RANDOM_POOL_INDEX >= ${#RANDOM_POOL[@]} )); then
    refill_random_pool || return 1
  fi
  RANDOM_WORD=${RANDOM_POOL[RANDOM_POOL_INDEX]}
  RANDOM_POOL_INDEX=$((RANDOM_POOL_INDEX + 1))
}

wipe_random_pool() {
  RANDOM_POOL=()
  RANDOM_POOL_INDEX=0
  RANDOM_WORD=""
  unset RANDOM_WORD
}

random_below() {
  local limit=$1 value cutoff
  (( limit > 0 )) || return 1
  cutoff=$((4294967296 - (4294967296 % limit)))
  while :; do
    next_random_word || return 1
    value=$RANDOM_WORD
    [[ $value =~ ^[0-9]+$ ]] || continue
    if (( value < cutoff )); then
      RANDOM_BELOW=$((value % limit))
      return 0
    fi
  done
}

append_random_char() {
  local charset=$1
  random_below "${#charset}" || return 1
  GENERATED_PASSWORD+=${charset:RANDOM_BELOW:1}
}

generate_password() {
  if fill_generated_password; then
    wipe_random_pool
    return 0
  fi
  wipe_random_pool
  return 1
}

fill_generated_password() {
  local uppercase='ABCDEFGHIJKLMNOPQRSTUVWXYZ'
  local lowercase='abcdefghijklmnopqrstuvwxyz'
  local digits='0123456789'
  local symbols='!@#$%^&*()-_=+'
  local alphabet="${uppercase}${lowercase}${digits}${symbols}"
  local combined i swap_index temporary
  local -a characters=()

  GENERATED_PASSWORD=""
  append_random_char "$uppercase" || return 1
  append_random_char "$lowercase" || return 1
  append_random_char "$digits" || return 1
  append_random_char "$symbols" || return 1
  for (( i = 4; i < 24; i++ )); do
    append_random_char "$alphabet" || return 1
  done

  combined=$GENERATED_PASSWORD
  GENERATED_PASSWORD=""
  for (( i = 0; i < ${#combined}; i++ )); do
    characters+=("${combined:i:1}")
  done
  combined=""
  for (( i = ${#characters[@]} - 1; i > 0; i-- )); do
    random_below "$((i + 1))" || return 1
    swap_index=$RANDOM_BELOW
    temporary=${characters[i]}
    characters[i]=${characters[swap_index]}
    characters[swap_index]=$temporary
  done
  printf -v GENERATED_PASSWORD '%s' "${characters[@]}"
}

normalize_clear_seconds() {
  local raw=$1 normalized
  [[ $raw =~ ^[0-9]+$ ]] || return 1
  normalized=${raw#"${raw%%[!0]*}"}
  [[ -n $normalized ]] || normalized=0
  (( ${#normalized} <= 3 )) || return 1
  (( 10#$normalized <= 300 )) || return 1
  NORMALIZED_CLEAR_SECONDS=$((10#$normalized))
}

clip_hash_path() {
  local runtime_dir=${XDG_RUNTIME_DIR:-}
  [[ -n $runtime_dir && -d $runtime_dir && ! -L $runtime_dir ]] || return 1
  printf '%s/%s' "$runtime_dir" "$CLIP_HASH_BASENAME"
}

read_clip_hash() {
  local path hash
  path=$(clip_hash_path) || return 1
  [[ -f $path && ! -L $path ]] || return 1
  hash=$(<"$path")
  [[ $hash =~ ^[0-9a-f]{64}$ ]] || return 2
  CLIP_HASH=$hash
}

write_clip_hash() {
  local hash=$1 path temporary
  [[ $hash =~ ^[0-9a-f]{64}$ ]] || return 1
  path=$(clip_hash_path) || return 1
  umask 077
  temporary=$(mktemp "${path}.XXXXXX") || return 1
  if ! printf '%s\n' "$hash" >"$temporary" ||
     ! chmod 600 "$temporary" ||
     ! mv -f -- "$temporary" "$path"; then
    rm -f -- "$temporary"
    return 1
  fi
}

remove_clip_hash_if_matches() {
  local expected=$1 path
  path=$(clip_hash_path) || return 0
  if read_clip_hash && [[ $CLIP_HASH == "$expected" ]]; then
    rm -f -- "$path"
  fi
}

recents_path() {
  local state_home=${XDG_STATE_HOME:-}
  if [[ -z $state_home ]]; then
    [[ -n ${HOME:-} ]] || return 1
    state_home=$HOME/.local/state
  fi
  printf '%s/%s/%s' "$state_home" "$RECENTS_DIRNAME" "$RECENTS_BASENAME"
}

load_recents_data() {
  local path loaded
  path=$(recents_path) || return 1
  if [[ ! -e $path ]]; then
    RECENTS_DATA='[]'
    return 0
  fi
  [[ -f $path && ! -L $path ]] || return 1
  loaded=$(jq -ce --argjson limit "$RECENTS_LIMIT" '
    select(
      type == "object" and (keys == ["recents"]) and
      (.recents | type == "array" and length <= $limit) and
      all(.recents[];
        (keys | sort) == ["itemId", "shareId", "ts"] and
        (.shareId | type == "string" and test("^[A-Za-z0-9+/=_-]{1,256}$")) and
        (.itemId | type == "string" and test("^[A-Za-z0-9+/=_-]{1,256}$")) and
        (.ts | type == "number" and . >= 0 and floor == .)
      )
    ) | .recents
  ' "$path" 2>/dev/null) || return 1
  RECENTS_DATA=$loaded
}

write_recents_data() {
  local recents=$1 path directory temporary
  path=$(recents_path) || return 1
  directory=${path%/*}
  [[ ! -L $directory ]] || return 1
  umask 077
  if [[ ! -d $directory ]]; then
    mkdir -p -- "$directory" || return 1
    chmod 700 "$directory" || return 1
  fi
  temporary=$(mktemp "$directory/.recents.json.XXXXXX") || return 1
  if ! jq -cn --argjson recents "$recents" '{recents: $recents}' >"$temporary" ||
     ! chmod 600 "$temporary" ||
     ! mv -f -- "$temporary" "$path"; then
    rm -f -- "$temporary"
    return 1
  fi
}

note_recent() {
  local share_id=$1 item_id=$2 timestamp updated
  load_recents_data || return 1
  timestamp=$(date +%s) || return 1
  [[ $timestamp =~ ^[0-9]+$ ]] || return 1
  updated=$(jq -cn \
    --arg shareId "$share_id" \
    --arg itemId "$item_id" \
    --argjson ts "$timestamp" \
    --argjson recents "$RECENTS_DATA" \
    --argjson limit "$RECENTS_LIMIT" '
      ([{shareId: $shareId, itemId: $itemId, ts: $ts}] +
       [$recents[] | select(.shareId != $shareId or .itemId != $itemId)])[:$limit]
    ') || return 1
  write_recents_data "$updated"
}

doctor_command() {
  local pass_present=false clipboard_present=false
  local version="" version_output="" message="Dependencies are available"

  if command -v pass-cli >/dev/null 2>&1; then
    pass_present=true
    if version_output=$(run_pass_cli "$DOCTOR_TIMEOUT_SECONDS" --version 2>/dev/null) &&
       [[ $version_output =~ ([0-9]+\.[0-9]+\.[0-9]+) ]]; then
      version=${BASH_REMATCH[1]}
    fi
  fi

  if command -v wl-copy >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
    clipboard_present=true
  fi

  if [[ $pass_present == false || $clipboard_present == false ]]; then
    emit_doctor missing-deps "Required dependencies are missing" \
      "$pass_present" "$version" "$clipboard_present"
  elif [[ -z $version ]]; then
    emit_doctor ok "Could not determine pass-cli version" \
      "$pass_present" "$version" "$clipboard_present"
  elif [[ ${version%%.*} != 2 ]]; then
    emit_doctor ok "Unexpected pass-cli major version; expected 2.x" \
      "$pass_present" "$version" "$clipboard_present"
  else
    emit_doctor ok "$message" "$pass_present" "$version" "$clipboard_present"
  fi
}

parse_index_args() {
  local exclude_vaults="" seen_exclude=false

  while (( $# > 0 )); do
    case $1 in
      --exclude-vaults)
        if [[ $seen_exclude == true || $# -lt 2 ]]; then return 2; fi
        exclude_vaults=$2
        seen_exclude=true
        shift 2
        ;;
      *) return 2 ;;
    esac
  done

  [[ $seen_exclude == true ]] || return 2
  INDEX_EXCLUDE_VAULTS=$exclude_vaults
}

parse_copy_args() {
  local share_id="" item_id="" field="" clear_seconds=""
  local seen_share=false seen_item=false seen_field=false seen_clear=false paste_once=false

  while (( $# > 0 )); do
    case $1 in
      --share-id)
        if [[ $seen_share == true || $# -lt 2 ]]; then return 2; fi
        share_id=$2
        seen_share=true
        shift 2
        ;;
      --item-id)
        if [[ $seen_item == true || $# -lt 2 ]]; then return 2; fi
        item_id=$2
        seen_item=true
        shift 2
        ;;
      --field)
        if [[ $seen_field == true || $# -lt 2 ]]; then return 2; fi
        field=$2
        seen_field=true
        shift 2
        ;;
      --clear-seconds)
        if [[ $seen_clear == true || $# -lt 2 ]]; then return 2; fi
        clear_seconds=$2
        seen_clear=true
        shift 2
        ;;
      --paste-once)
        if [[ $paste_once == true ]]; then return 2; fi
        paste_once=true
        shift
        ;;
      *) return 2 ;;
    esac
  done

  [[ $seen_share == true && $seen_item == true && $seen_field == true && $seen_clear == true ]] || return 2
  valid_id "$share_id" || return 2
  valid_id "$item_id" || return 2
  [[ $field == username || $field == password || $field == totp ]] || return 2
  normalize_clear_seconds "$clear_seconds" || return 2
  COPY_SHARE_ID=$share_id
  COPY_ITEM_ID=$item_id
  COPY_FIELD=$field
  COPY_CLEAR_SECONDS=$NORMALIZED_CLEAR_SECONDS
  COPY_PASTE_ONCE=$paste_once
}

parse_create_args() {
  local share_id="" seen_share=false

  while (( $# > 0 )); do
    case $1 in
      --share-id)
        if [[ $seen_share == true || $# -lt 2 ]]; then return 2; fi
        share_id=$2
        seen_share=true
        shift 2
        ;;
      *) return 2 ;;
    esac
  done

  [[ $seen_share == true ]] || return 2
  valid_id "$share_id" || return 2
  CREATE_SHARE_ID=$share_id
}

read_create_input() {
  CREATE_INPUT=$(cat)
  jq -e '
    type == "object" and
    ((keys | sort) == ["title", "username"] or
     (keys | sort) == ["email", "title"]) and
    (.title | type == "string" and length > 0 and length <= 500) and
    if has("username") then
      (.username | type == "string" and length <= 500)
    else
      (.email | type == "string" and length <= 500)
    end
  ' <<<"$CREATE_INPUT" >/dev/null 2>&1
}

parse_recents_args() {
  local operation=${1:-}
  case $operation in
    load)
      (( $# == 1 )) || return 2
      RECENTS_OPERATION=load
      ;;
    clear)
      (( $# == 1 )) || return 2
      RECENTS_OPERATION=clear
      ;;
    *) return 2 ;;
  esac
}

clear_recents_data() {
  local path
  path=$(recents_path) || return 1
  if [[ ! -e $path && ! -L $path ]]; then
    return 0
  fi
  [[ -f $path || -L $path ]] || return 1
  rm -f -- "$path"
}

index_command() {
  local vault_stdout="" vault_stderr="" vaults="[]" contract_vaults="[]" items="[]" warnings="[]"
  local vault_status=0 vault_json share_id item_stdout item_stderr item_status mapped
  local deadline_epoch remaining vault_timeout vault_total vaults_walked=0 items_total=0 mapped_count

  if ! command -v pass-cli >/dev/null 2>&1; then
    fail_classified index 127 ""
    return 0
  fi

  deadline_epoch=$(( $(date +%s) + INDEX_DEADLINE_SECONDS ))
  CAPTURE_MAX_BYTES=$INDEX_MAX_RESPONSE_BYTES
  run_pass_cli_captured false vault_stdout vault_stderr vault_status \
    "$INDEX_TIMEOUT_SECONDS" vault list --output json
  if (( vault_status != 0 )); then
    fail_classified index "$vault_status" "$vault_stderr"
    return 0
  fi

  if ! jq -e '
      type == "object" and
      (.vaults | type) == "array" and
      all(.vaults[];
        (.name | type == "string" and length > 0) and
        (.share_id | type) == "string" and
        (.share_id | test("^[A-Za-z0-9+/=_-]{1,256}$"))
      )
    ' <<<"$vault_stdout" >/dev/null 2>&1; then
    emit_index error "Something went wrong talking to pass-cli" '[]' '[]' '[]'
    return 0
  fi

  vaults=$(jq -c --arg excluded "$INDEX_EXCLUDE_VAULTS" '
    def trim: sub("^[[:space:]]+"; "") | sub("[[:space:]]+$"; "");
    ($excluded | split(",") | map(trim) | map(select(length > 0))) as $excludedNames
    | [.vaults[] | select(.name as $name | ($excludedNames | index($name) | not))]
  ' <<<"$vault_stdout")
  vault_total=$(jq 'length' <<<"$vaults")
  if (( vault_total > INDEX_MAX_VAULTS )); then
    vaults=$(jq -c --argjson limit "$INDEX_MAX_VAULTS" '.[0:$limit]' <<<"$vaults")
    warnings=$(jq -cn --argjson warnings "$warnings" --argjson limit "$INDEX_MAX_VAULTS" \
      '$warnings + ["Only the first \($limit) vaults were indexed"]')
  fi

  contract_vaults=$(jq -c --argjson limit "$INDEX_DISPLAY_TEXT_LIMIT" \
    '[.[] | {shareId: .share_id, name: (.name[0:$limit])}]' <<<"$vaults")

  if ! open_index_scratch; then
    emit_index error "Something went wrong talking to pass-cli" '[]' '[]' '[]'
    return 0
  fi

  while IFS= read -r vault_json; do
    # One deadline governs the whole walk. Per-request timeouts do not compose:
    # N vaults at INDEX_TIMEOUT_SECONDS each is N times the bound, which is no
    # bound at all when N is attacker-chosen.
    remaining=$(( deadline_epoch - $(date +%s) ))
    if (( remaining <= 0 )); then
      warnings=$(jq -cn --argjson warnings "$warnings" \
        '$warnings + ["Indexing stopped at the time limit; some vaults were skipped"]')
      break
    fi
    if (( items_total >= INDEX_MAX_ITEMS_TOTAL )); then
      warnings=$(jq -cn --argjson warnings "$warnings" --argjson limit "$INDEX_MAX_ITEMS_TOTAL" \
        '$warnings + ["Some items were not indexed (limit \($limit) reached)"]')
      break
    fi
    vault_timeout=$INDEX_TIMEOUT_SECONDS
    if (( remaining < vault_timeout )); then
      vault_timeout=$remaining
    fi
    vaults_walked=$(( vaults_walked + 1 ))

    share_id=$(jq -r '.share_id' <<<"$vault_json")
    CAPTURE_MAX_BYTES=$INDEX_MAX_RESPONSE_BYTES
    run_pass_cli_captured false item_stdout item_stderr item_status \
      "$vault_timeout" item list \
      --share-id "$share_id" \
      --filter-type login \
      --filter-state active \
      --output json
    : "$item_stderr"

    if (( item_status != 0 )) || ! jq -e --arg shareId "$share_id" '
        type == "object" and
        (.items | type) == "array" and
        all(.items[];
          (.id | type) == "string" and
          (.id | test("^[A-Za-z0-9+/=_-]{1,256}$")) and
          (.share_id | type) == "string" and
          .share_id == $shareId and
          (.title | type) == "string" and
          (.create_time | type) == "string"
        )
      ' <<<"$item_stdout" >/dev/null 2>&1; then
      if [[ $CAPTURE_WAS_TRUNCATED == true ]]; then
        warnings=$(jq -cn --argjson warnings "$warnings" \
          '$warnings + ["A vault was too large to index"]')
      else
        warnings=$(jq -cn --argjson warnings "$warnings" \
          '$warnings + ["A vault could not be loaded"]')
      fi
      continue
    fi

    # Two ceilings apply per vault: its own item cap, and whatever remains of
    # the global one. jq applies both in a single pass.
    mapped=$(jq -c --argjson vault "$vault_json" \
      --argjson limit "$INDEX_DISPLAY_TEXT_LIMIT" \
      --argjson perVault "$INDEX_MAX_ITEMS_PER_VAULT" \
      --argjson remaining "$(( INDEX_MAX_ITEMS_TOTAL - items_total ))" '[
      .items[] | {
        itemId: .id,
        shareId: .share_id,
        vaultName: ($vault.name[0:$limit]),
        title: (.title[0:$limit]),
        createTime: .create_time
      }
    ] | .[0:(if $perVault < $remaining then $perVault else $remaining end)]' <<<"$item_stdout")
    mapped_count=$(jq 'length' <<<"$mapped")
    if (( mapped_count < $(jq '.items | length' <<<"$item_stdout") )); then
      warnings=$(jq -cn --argjson warnings "$warnings" \
        '$warnings + ["A vault held more logins than the index holds"]')
    fi
    items_total=$(( items_total + mapped_count ))
    # One line per vault, collapsed once after the walk. Concatenating the whole
    # accumulated array per vault re-serialises everything already gathered,
    # which is quadratic in the number of items an attacker supplies.
    printf '%s\n' "$mapped" >>"$INDEX_SCRATCH_FILE" || break
  done < <(jq -c '.[]' <<<"$vaults")

  CAPTURE_MAX_BYTES=0
  items=$(jq -cs 'add // []' "$INDEX_SCRATCH_FILE") || items='[]'
  : >"$INDEX_SCRATCH_FILE"
  : "$vaults_walked"

  if [[ $warnings == '[]' ]]; then
    emit_index ready "Login items ready" "$items" "$warnings" "$contract_vaults"
  else
    emit_index ready "Some vaults could not be loaded" "$items" "$warnings" "$contract_vaults"
  fi
}

copy_command() {
  local +x val="" stderr_blob="" status=0 fallback_used=false hash secs cur stored
  local -a copy_args=(--sensitive)

  if ! command -v pass-cli >/dev/null 2>&1; then
    fail_classified copy 127 ""
    return 0
  fi
  if ! command -v wl-copy >/dev/null 2>&1 ||
     { (( COPY_CLEAR_SECONDS > 0 )) && ! command -v wl-paste >/dev/null 2>&1; }; then
    emit_copy error "Copy failed — check connection and try again" \
      "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
    return 0
  fi

  case $COPY_FIELD in
    username)
      run_pass_cli_captured true val stderr_blob status \
        "$COPY_TIMEOUT_SECONDS" item view \
        --share-id "$COPY_SHARE_ID" --item-id "$COPY_ITEM_ID" --field username
      if (( status != 0 )); then
        classify_failure copy "$status" "$stderr_blob"
        if [[ $CLASSIFIED_STATE != no-field ]]; then
          emit_copy_classified_failure "No username or email on this item"
          unset val
          return 0
        fi
      fi
      if (( status != 0 )) || [[ -z $val ]]; then
        run_pass_cli_captured true val stderr_blob status \
          "$COPY_TIMEOUT_SECONDS" item view \
          --share-id "$COPY_SHARE_ID" --item-id "$COPY_ITEM_ID" --field email
        if (( status != 0 )); then
          fail_classified copy "$status" "$stderr_blob" "No username or email on this item"
          unset val
          return 0
        fi
        if [[ -z $val ]]; then
          emit_copy no-field "No username or email on this item" \
            "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
          unset val
          return 0
        fi
        fallback_used=true
      fi
      ;;
    password)
      run_pass_cli_captured true val stderr_blob status \
        "$COPY_TIMEOUT_SECONDS" item view \
        --share-id "$COPY_SHARE_ID" --item-id "$COPY_ITEM_ID" --field password
      if (( status != 0 )); then
        fail_classified copy "$status" "$stderr_blob" "No password on this item"
        unset val
        return 0
      fi
      if [[ -z $val ]]; then
        emit_copy no-field "No password on this item" \
          "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
        unset val
        return 0
      fi
      ;;
    totp)
      run_pass_cli_captured true val stderr_blob status \
        "$COPY_TIMEOUT_SECONDS" item totp \
        --share-id "$COPY_SHARE_ID" --item-id "$COPY_ITEM_ID" --output json
      if (( status != 0 )); then
        fail_classified copy "$status" "$stderr_blob" "No TOTP on this item"
        unset val
        return 0
      fi
      if ! printf '%s' "$val" | jq -e '
          type == "object" and length > 0 and
          all(.[]; type == "string" and length > 0)
        ' >/dev/null 2>&1; then
        emit_copy error "Copy failed — check connection and try again" \
          "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
        unset val
        return 0
      fi
      val=$(printf '%s' "$val" | jq -r '
        if has("totp") then .totp
        else
          (to_entries | map(select(.key | endswith("_uri") | not))) as $codes
          | if ($codes | length) > 0 then $codes[0].value
            else (to_entries[0].value)
            end
        end
      '; printf x)
      val=${val%x}
      val=${val%$'\n'}
      ;;
  esac

  hash=$(printf '%s' "$val" | sha256sum | cut -d' ' -f1)
  if ! write_clip_hash "$hash"; then
    unset val
    emit_copy error "Copy failed — check connection and try again" \
      "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
    return 0
  fi

  if [[ $COPY_PASTE_ONCE == true ]]; then copy_args+=(-o); fi
  if ! printf '%s' "$val" | wl-copy "${copy_args[@]}" >/dev/null 2>&1; then
    unset val
    remove_clip_hash_if_matches "$hash"
    emit_copy error "Copy failed — check connection and try again" \
      "$COPY_FIELD" false "$COPY_CLEAR_SECONDS"
    return 0
  fi
  unset val

  if (( COPY_CLEAR_SECONDS > 0 )); then
    secs=$COPY_CLEAR_SECONDS
    ( exec >/dev/null 2>&1 </dev/null
      trap - EXIT
      sleep "$secs"
      read_clip_hash || exit 0
      stored=$CLIP_HASH
      [ "$stored" = "$hash" ] || exit 0
      cur=$(wl-paste --no-newline 2>/dev/null | sha256sum | cut -d' ' -f1)
      if [ "$cur" = "$hash" ] &&
         read_clip_hash && [ "$CLIP_HASH" = "$hash" ] &&
         wl-copy --clear; then
        remove_clip_hash_if_matches "$hash"
      fi ) &
    disown
  fi

  emit_copy copied "Copied to clipboard" \
    "$COPY_FIELD" "$fallback_used" "$COPY_CLEAR_SECONDS"

  # Recent metadata is fail-soft and never gates the response: the clipboard
  # already holds the value, so bookkeeping runs after the envelope is out.
  note_recent "$COPY_SHARE_ID" "$COPY_ITEM_ID" || true
}

clear_now_command() {
  local hash cur read_status=0

  read_clip_hash || read_status=$?
  if (( read_status != 0 )); then
    case $read_status in
      1) emit_simple clear-now not-owner "Clipboard is not owned by Proton Pass" ;;
      *) emit_simple clear-now error "Could not verify the clipboard" ;;
    esac
    return 0
  fi
  hash=$CLIP_HASH

  if ! command -v wl-copy >/dev/null 2>&1 || ! command -v wl-paste >/dev/null 2>&1; then
    emit_simple clear-now error "Could not clear the clipboard"
    return 0
  fi
  if ! cur=$(wl-paste --no-newline 2>/dev/null | sha256sum | cut -d' ' -f1); then
    emit_simple clear-now error "Could not verify the clipboard"
    return 0
  fi
  if [[ $cur != "$hash" ]]; then
    emit_simple clear-now not-owner "Clipboard is not owned by Proton Pass"
    return 0
  fi
  # Closing stdin keeps a clear from ever waiting on the caller's input.
  if ! read_clip_hash || [[ $CLIP_HASH != "$hash" ]] || ! wl-copy --clear </dev/null >/dev/null 2>&1; then
    emit_simple clear-now error "Could not clear the clipboard"
    return 0
  fi

  remove_clip_hash_if_matches "$hash"
  emit_simple clear-now cleared "Clipboard cleared"
}

recents_command() {
  case $RECENTS_OPERATION in
    load)
      if load_recents_data; then
        emit_recents ok "Recent items ready" "$RECENTS_DATA"
      else
        emit_recents error "Could not load recent items" '[]'
      fi
      ;;
    clear)
      if clear_recents_data; then
        emit_simple recents ok "Recent items cleared"
      else
        emit_simple recents error "Could not clear recent items"
      fi
      ;;
  esac
}

create_command() {
  local +x password="" stdout="" stderr_blob=""
  local status=0 password_read

  if ! read_create_input; then
    CREATE_INPUT=""
    unset CREATE_INPUT
    emit_create invalid-input "Enter a title and exactly one username or email"
    return 0
  fi

  if ! command -v pass-cli >/dev/null 2>&1; then
    CREATE_INPUT=""
    unset CREATE_INPUT
    fail_classified create 127 ""
    return 0
  fi

  if ! generate_password; then
    GENERATED_PASSWORD=""
    CREATE_INPUT=""
    unset GENERATED_PASSWORD CREATE_INPUT
    emit_create error "Could not create login"
    return 0
  fi
  password=$GENERATED_PASSWORD
  GENERATED_PASSWORD=""
  unset GENERATED_PASSWORD

  if ! exec {password_read}< <(printf '%s' "$password"); then
    password=""
    CREATE_INPUT=""
    unset password CREATE_INPUT
    emit_create error "Could not create login"
    return 0
  fi

  run_pass_cli_captured false stdout stderr_blob status \
    "$CREATE_TIMEOUT_SECONDS" item create login \
    --share-id "$CREATE_SHARE_ID" --from-template - < <(
      jq -c --rawfile generatedPassword "/dev/fd/$password_read" '
        {
          title: .title,
          username: (if has("username") then .username else null end),
          email: (if has("email") then .email else null end),
          password: $generatedPassword,
          totp_uri: null,
          urls: []
        }
      ' <<<"$CREATE_INPUT" 2>/dev/null
    )

  exec {password_read}<&-
  password=""
  CREATE_INPUT=""
  unset password CREATE_INPUT

  if (( status != 0 )); then
    fail_classified create "$status" "$stderr_blob"
    return 0
  fi
  if ! valid_id "$stdout"; then
    emit_create error "Could not create login"
    return 0
  fi

  # Recent metadata is fail-soft because the login already exists remotely.
  note_recent "$CREATE_SHARE_ID" "$stdout" || true
  emit_create created "Login created" "$stdout" "$CREATE_SHARE_ID"
}

lock_command() {
  local stdout="" stderr_blob="" status=0

  if ! command -v pass-cli >/dev/null 2>&1; then
    fail_classified lock 127 ""
    return 0
  fi

  run_pass_cli_captured false stdout stderr_blob status \
    "$LOCK_TIMEOUT_SECONDS" session lock
  : "$stdout"
  if (( status == 0 )); then
    emit_simple lock locked "Session locked"
  else
    fail_classified lock "$status" "$stderr_blob"
  fi
}

logout_command() {
  local stdout="" stderr_blob="" status=0

  if ! command -v pass-cli >/dev/null 2>&1; then
    emit_simple logout cli-missing "Proton Pass CLI not found"
    return 0
  fi

  run_pass_cli_captured false stdout stderr_blob status \
    "$LOGOUT_TIMEOUT_SECONDS" logout
  : "$stdout"
  if (( status == 0 )); then
    emit_simple logout logged-out-ok "Signed out of Proton Pass"
    return 0
  fi

  fail_classified logout "$status" "$stderr_blob"
}

main() {
  local command_name
  if (( $# == 0 )); then
    emit_argument_error
    return 2
  fi

  command_name=$1
  shift
  case $command_name in
    doctor)
      if (( $# != 0 )); then emit_argument_error doctor; return 2; fi
      doctor_command
      ;;
    index)
      if ! parse_index_args "$@"; then emit_argument_error index; return 2; fi
      index_command
      ;;
    copy)
      if ! parse_copy_args "$@"; then emit_argument_error copy; return 2; fi
      copy_command
      ;;
    create)
      if ! parse_create_args "$@"; then emit_argument_error create; return 2; fi
      create_command
      ;;
    lock)
      if (( $# != 0 )); then emit_argument_error lock; return 2; fi
      lock_command
      ;;
    logout)
      if (( $# != 0 )); then emit_argument_error logout; return 2; fi
      logout_command
      ;;
    clear-now)
      if (( $# != 0 )); then emit_argument_error clear-now; return 2; fi
      clear_now_command
      ;;
    recents)
      if ! parse_recents_args "$@"; then emit_argument_error recents; return 2; fi
      recents_command
      ;;
    *)
      emit_argument_error
      return 2
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
